{
  "name": "mable",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3014",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/*.test.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "test:integration": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run tests/integration/worker.test.ts",
    "stop": "node scripts/stop.mjs"
  },
  "dependencies": {
    "@ai-sdk/typesafe-ai": "3.0.5",
    "@better-auth/drizzle-adapter": "1.7.5",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "ai": "7.0.112",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/react": "19",
    "@types/react-dom": "19",
    "drizzle-kit": "0.31.11",
    "eslint": "9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4",
    "tsx": "4.23.15",
    "typescript": "5",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@11.0.5"
}
